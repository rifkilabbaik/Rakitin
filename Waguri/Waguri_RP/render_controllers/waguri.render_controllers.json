{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.waguri.first_person": {
      "arrays": {
        "geometries": {
          "Array.model": [
            "Geometry.waguri_kaoruko",
            "Geometry.waguri_kaoruko_kasual",
            "Geometry.waguri_subaru",
            "Geometry.waguri_rintaro",
            "Geometry.waguri_saku",
            "Geometry.waguri_usami",
            "Geometry.waguri_ayato"
          ]
        },
        "textures": {
          "Array.kulit": [
            "Texture.waguri_kaoruko",
            "Texture.waguri_kaoruko_kasual",
            "Texture.waguri_subaru",
            "Texture.waguri_rintaro",
            "Texture.waguri_saku",
            "Texture.waguri_usami",
            "Texture.waguri_ayato"
          ]
        }
      },
      "geometry": "Array.model[math.clamp(q.property('waguri:model') - 1, 0, 6)]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.kulit[math.clamp(q.property('waguri:model') - 1, 0, 6)]"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "rightArm": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map'"
        },
        {
          "leftArm": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        }
      ]
    },
    "controller.render.waguri.third_person": {
      "arrays": {
        "geometries": {
          "Array.model": [
            "Geometry.waguri_kaoruko",
            "Geometry.waguri_kaoruko_kasual",
            "Geometry.waguri_subaru",
            "Geometry.waguri_rintaro",
            "Geometry.waguri_saku",
            "Geometry.waguri_usami",
            "Geometry.waguri_ayato"
          ]
        },
        "textures": {
          "Array.kulit": [
            "Texture.waguri_kaoruko",
            "Texture.waguri_kaoruko_kasual",
            "Texture.waguri_subaru",
            "Texture.waguri_rintaro",
            "Texture.waguri_saku",
            "Texture.waguri_usami",
            "Texture.waguri_ayato"
          ]
        }
      },
      "geometry": "Array.model[math.clamp(q.property('waguri:model') - 1, 0, 6)]",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.kulit[math.clamp(q.property('waguri:model') - 1, 0, 6)]"
      ],
      "part_visibility": [
        {
          "*": true
        }
      ]
    }
  }
}
